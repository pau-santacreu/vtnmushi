# ============================================
# VoiceNotes (vtnmushi) — Environment Config
# ============================================
# Copia aquest fitxer a .env i edita els valors

# --- Database ---
DATABASE_URL=postgresql://voicenotes:canvia_aquesta_password@db:5432/voicenotes
POSTGRES_DB=voicenotes
POSTGRES_USER=voicenotes
POSTGRES_PASSWORD=canvia_aquesta_password

# --- JWT Authentication ---
JWT_SECRET_KEY=canvia-aixo-per-un-secret-segur-generat-amb-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Whisper STT ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
DEFAULT_LANGUAGE=ca

# --- File Upload ---
MAX_AUDIO_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,m4a,webm,flac

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
