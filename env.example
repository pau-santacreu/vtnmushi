# ============================================
# VoiceNotes (vtnmushi) — Environment Config
# ============================================
# Copia aquest fitxer a .env i edita els valors

# --- Database ---
DATABASE_URL=postgresql://voicenotes:voicenotes123@db:5432/voicenotes
POSTGRES_DB=voicenotes
POSTGRES_USER=voicenotes
POSTGRES_PASSWORD=voicenotes123

# --- JWT Authentication ---
JWT_SECRET_KEY=patata3000
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Whisper STT --- VEGAPUNK
#WHISPER_MODEL=large-v3
#WHISPER_DEVICE=cuda
#WHISPER_COMPUTE_TYPE=float16
#DEFAULT_LANGUAGE=ca

# --- Whisper STT --- Portatil
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
DEFAULT_LANGUAGE=ca

# --- File Upload ---
MAX_AUDIO_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=wav,mp3,ogg,m4a,webm,flac

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
